# ─── База данных ───
# PostgreSQL (рекомендуется для production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hookah
# SQLite (для быстрого старта, без Docker)
# DATABASE_URL=sqlite+aiosqlite:///./hookah.db

# ─── LLM-провайдер ───
# mock — захардкоженные ответы (для разработки)
# gigachat — Sber GigaChat API
# yandexgpt — Yandex YandexGPT API
# ab — A/B тест между gigachat и yandexgpt
LLM_PROVIDER=mock

# Процент пользователей на GigaChat при A/B (остальные на YandexGPT)
AB_SPLIT=50

# ─── Rate limiting ───
DAILY_REQUEST_LIMIT=5
DISABLE_DAILY_LIMIT=true

# ─── GigaChat (если LLM_PROVIDER=gigachat или ab) ───
# Ключ авторизации со страницы developers.sber.ru → GigaChat API
# GIGACHAT_AUTH_KEY=ваш_authorization_key
# Scope: GIGACHAT_API_PERS (бесплатный), GIGACHAT_API_B2B, GIGACHAT_API_CORP
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat, GigaChat-Pro, GigaChat-2-Lite, GigaChat-2-Pro, GigaChat-2-Max
# GIGACHAT_MODEL=GigaChat

# ─── YandexGPT (если LLM_PROVIDER=yandexgpt или ab) ───
# API-ключ из console.yandex.cloud → IAM → API-ключи
# YANDEXGPT_API_KEY=ваш_api_key
# ID каталога из console.yandex.cloud
# YANDEXGPT_FOLDER_ID=ваш_folder_id
# Модель: yandexgpt-lite/latest (быстрая), yandexgpt/latest (полная), yandexgpt-pro/latest
# YANDEXGPT_MODEL=yandexgpt-lite/latest

# ─── Telegram Bot (для будущих уведомлений) ───
# BOT_TOKEN=

# ─── CORS (через запятую, для production) ───
# CORS_ORIGINS=https://your-app.vercel.app

# ─── Admin panel (логин/пароль) ───
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# ADMIN_JWT_SECRET=change-me-in-production
