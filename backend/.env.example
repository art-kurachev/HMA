# ─── База данных ───
# PostgreSQL (рекомендуется для production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hookah
# SQLite (для быстрого старта, без Docker)
# DATABASE_URL=sqlite+aiosqlite:///./hookah.db

# ─── LLM-провайдер ───
# mock — захардкоженные ответы (для разработки)
# gigachat — Sber GigaChat API
LLM_PROVIDER=mock

# ─── Rate limiting ───
DAILY_REQUEST_LIMIT=5
DISABLE_DAILY_LIMIT=true

# ─── GigaChat (если LLM_PROVIDER=gigachat или ab) ───
# Ключ авторизации со страницы developers.sber.ru → GigaChat API
# GIGACHAT_AUTH_KEY=ваш_authorization_key
# Scope: GIGACHAT_API_PERS (бесплатный), GIGACHAT_API_B2B, GIGACHAT_API_CORP
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2-Max, GigaChat-2-Pro, GigaChat-2-Lite
# GIGACHAT_MODEL=GigaChat-2-Pro

# ─── Telegram Bot (уведомления + оплата Stars) ───
# BOT_TOKEN=your_bot_token_from_BotFather
# APP_URL — публичный URL бэкенда (для автоматической регистрации вебхука Telegram)
# APP_URL=https://your-backend.up.railway.app

# ─── CORS (через запятую, для production) ───
# CORS_ORIGINS=https://your-app.vercel.app

# ─── Creator (без лимитов) ───
# Telegram ID создателя через запятую, например: 123456789
# CREATOR_TELEGRAM_IDS=123456789

# ─── Admin panel (логин/пароль) ───
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# ADMIN_JWT_SECRET=change-me-in-production
